# Configuración de la base de datos
DATABASE_URL="postgresql://usuario:password@localhost:5432/unifood"

# Configuración de Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Configuración de JWT
JWT_SECRET=tu_jwt_secret_aqui
JWT_EXPIRES_IN=24h

# Configuración de Gemini AI
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.4
CHAT_RECOMMENDATION_LIMIT=3

# Modelos disponibles (solo los que funcionan):
# - gemini-2.5-flash-lite (recomendado - más estable y rápido)
# - gemini-2.5-flash (funciona perfectamente)
# - gemini-2.5-pro (funciona perfectamente)

# Configuración del servidor
PORT=3000
NODE_ENV=development
